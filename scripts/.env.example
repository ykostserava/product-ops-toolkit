# Copy to scripts/.env (gitignored). Read by scripts/jira_api.py.
JIRA_BASE_URL=https://your-jira.example.com
JIRA_API_TOKEN=
# bearer = personal access token (Jira Server / Data Center, default)
# basic  = Atlassian Cloud email + API token (set JIRA_USERNAME too)
JIRA_AUTH=bearer
JIRA_USERNAME=
# set to false only for an internal CA you cannot add to the trust store
JIRA_SSL_VERIFY=true
